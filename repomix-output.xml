/* ===== Mobile responsiveness baseline fixes ===== */
html,
body,
#root {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  min-width: 0; /* prevents flex/grid children overflow */
}

img,
video,
canvas,
svg,
iframe {
  max-width: 100%;
  height: auto;
  display: block;
}

/* stop long strings/URLs from forcing horizontal scroll */
p,
h1,
h2,
h3,
h4,
h5,
h6,
span,
a,
button,
li,
td,
th {
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* iOS Safari input auto-zoom fix */
