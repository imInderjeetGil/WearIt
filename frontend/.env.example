# Copy to `.env` for local development (do not commit `.env`).
#
# VITE_API_URL is read at BUILD time by Vite and inlined into the bundle
# (see src/shared/api/http.js). The default, when unset, is "/api/v1".
#
# Production build (served by nginx on the same origin):
#   VITE_API_URL=/api/v1
#
# Local development (Vite dev server, no proxy -> hit FastAPI directly).
# FastAPI routers carry NO /api/v1 prefix; nginx is what adds/strips it.
VITE_API_URL=http://localhost:8000
