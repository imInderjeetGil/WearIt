# Copy this file to `backend/.env` and fill in real values.
# NEVER commit `backend/.env` — it holds secrets.
#
# In the Docker stack, all of these (plus DB_USER/DB_PASSWORD/DB_NAME) are
# provided by the root `.env` on the host (see ../.env.example).

# ---- Database (contains credentials -> SECRET) ------------------------------
# Local development URL. In the Docker/production stack the host is the
# compose service name `db`.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/wearit_db

# ---- App --------------------------------------------------------------------
# dev | prod  (prod hides /docs & /redoc; schema is managed ONLY by Alembic)
ENV=dev
# Signs JWTs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_32BYTES_HEX
# Comma-separated allowed CORS origins (empty = dev default "*").
# Production (same-origin /api/v1) example: CORS_ORIGINS=https://wearit.inderforge.app
CORS_ORIGINS=
# One-time production admin bootstrap. Set true only during initial provisioning,
# then remove. Ignored in dev.
ADMIN_BOOTSTRAP_ENABLED=false

# ---- Razorpay (SECRETS) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME

# ---- AWS S3 (AWS_SECRET_ACCESS_KEY is a SECRET) -----------------------------
AWS_ACCESS_KEY_ID=AKIACHANGEME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-wearit-bucket

# ---- Gemini (PAUSED feature; key optional at startup, SECRET) ---------------
GEMINI_API_KEY=CHANGE_ME
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
