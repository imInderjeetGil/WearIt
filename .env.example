# Copy this file to `.env` (repo root) on the production host.
# docker-compose.prod.yml reads it BOTH for interpolation (${DB_USER}, ...)
# and passes it to the backend via `env_file`. NEVER commit the real `.env`.
#
# Backend container hostname for Postgres is `db` (the compose service name),
# NOT localhost.

# ---- Compose / PostgreSQL ---------------------------------------------------
# ${DB_USER} / ${DB_PASSWORD} / ${DB_NAME} are interpolated into the db service
# and used to build DATABASE_URL.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=wearit_db

# Used by the backend. Host `db` is the compose service, internal network only.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/wearit_db

# ---- ECR images (docker-compose.prod.yml) -----------------------------------
# ECR_REGISTRY = <aws_account_id>.dkr.ecr.<region>.amazonaws.com
# IMAGE_TAG = immutable version tag (e.g. v1.0.0). NEVER use "latest" in prod.
# Compose pulls:
#   ${ECR_REGISTRY}/wearit-backend:${IMAGE_TAG}
#   ${ECR_REGISTRY}/wearit-frontend:${IMAGE_TAG}
ECR_REGISTRY=000000000000.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=v1.0.0

# ---- App --------------------------------------------------------------------
ENV=prod
# Signs JWTs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_32BYTES_HEX
# Production is same-origin (/api/v1), so this may be empty; set it if the API
# is ever reached from another origin.
CORS_ORIGINS=https://wearit.inderforge.app
# Set true ONLY during one-time admin bootstrap, then remove the line.
ADMIN_BOOTSTRAP_ENABLED=false

# ---- Razorpay (SECRETS) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME

# ---- AWS S3 -----------------------------------------------------------------
# In production the EC2 IAM role (WearItEC2Role) provides AWS credentials
# automatically via the instance metadata service. boto3 then uses the default
# credential provider chain, so AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are
# OPTIONAL here — leave them unset/commented in production.
# They are only needed for LOCAL development, where no IAM role is attached.
# AWS_ACCESS_KEY_ID=AKIACHANGEME        # optional — local dev only
# AWS_SECRET_ACCESS_KEY=CHANGE_ME       # optional/local only (SECRET)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=wearit-production-images-bucket

# ---- Gemini (PAUSED feature; key optional at startup, SECRET) ---------------
GEMINI_API_KEY=CHANGE_ME
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
