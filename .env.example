# Copy this file to `.env` (repo root) on the production host.
# docker-compose.prod.yml reads it BOTH for interpolation (${DB_USER}, ...)
# and passes it to the backend via `env_file`. NEVER commit the real `.env`.
#
# Backend container hostname for Postgres is `db` (the compose service name),
# NOT localhost.

# ---- Compose / PostgreSQL ---------------------------------------------------
# ${DB_USER} / ${DB_PASSWORD} / ${DB_NAME} are interpolated into the db service
# and used to build DATABASE_URL.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=wearit_db

# Used by the backend. Host `db` is the compose service, internal network only.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/wearit_db

# ---- App --------------------------------------------------------------------
ENV=prod
# Signs JWTs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_32BYTES_HEX
# Production is same-origin (/api/v1), so this may be empty; set it if the API
# is ever reached from another origin.
CORS_ORIGINS=https://wearit.inderforge.app
# Set true ONLY during one-time admin bootstrap, then remove the line.
ADMIN_BOOTSTRAP_ENABLED=false

# ---- Razorpay (SECRETS) -----------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME

# ---- AWS S3 (AWS_SECRET_ACCESS_KEY is a SECRET) -----------------------------
# Prefer an EC2 IAM role so these are not needed. Long-lived keys are only a
# short-term option.
AWS_ACCESS_KEY_ID=AKIACHANGEME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-wearit-bucket

# ---- Gemini (PAUSED feature; key optional at startup, SECRET) ---------------
GEMINI_API_KEY=CHANGE_ME
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
